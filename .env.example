# Cấu hình chuỗi kết nối MongoDB Atlas
# Thay đổi username, password và cluster theo tài khoản đã tạo ở Bước 1
MONGODB_READ_URI=mongodb+srv://user_read:password@yourcluster.mongodb.net/books_db?retryWrites=true&w=majority
MONGODB_WRITE_URI=mongodb+srv://user_write:password@yourcluster.mongodb.net/books_db?retryWrites=true&w=majority

PORT=3000
SESSION_SECRET=my_secret_key_session
