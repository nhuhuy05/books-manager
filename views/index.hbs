<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản Lý Sách - Cloud Computing</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-gradient: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #0f172a 100%);
            --card-bg: rgba(30, 41, 59, 0.7);
            --card-border: rgba(255, 255, 255, 0.1);
            --text-primary: #f8fafc;
            --text-muted: #94a3b8;
            --accent-primary: #6366f1;
            --accent-hover: #4f46e5;
            --accent-emerald: #10b981;
            --accent-amber: #f59e0b;
            --glass-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        }

        body {
            min-height: 100vh;
            background: var(--bg-gradient);
            color: var(--text-primary);
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2.5rem 1.5rem;
            flex: 1;
            width: 100%;
        }

        /* Header */
        header {
            margin-bottom: 2.5rem;
            text-align: center;
        }

        .badge-cloud {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.35rem 1rem;
            border-radius: 9999px;
            background: rgba(99, 102, 241, 0.15);
            border: 1px solid rgba(99, 102, 241, 0.3);
            color: #a5b4fc;
            font-size: 0.85rem;
            font-weight: 600;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            margin-bottom: 1rem;
        }

        .badge-cloud span.pulse {
            width: 8px;
            height: 8px;
            background: var(--accent-emerald);
            border-radius: 50%;
            box-shadow: 0 0 10px var(--accent-emerald);
        }

        h1 {
            font-size: 2.5rem;
            font-weight: 800;
            letter-spacing: -0.02em;
            background: linear-gradient(to right, #ffffff, #c7d2fe);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 0.5rem;
        }

        p.subtitle {
            color: var(--text-muted);
            font-size: 1.05rem;
        }

        /* Architecture Badges */
        .arch-tags {
            display: flex;
            justify-content: center;
            gap: 1rem;
            margin-top: 1rem;
            flex-wrap: wrap;
        }

        .tag {
            font-size: 0.8rem;
            padding: 0.25rem 0.75rem;
            border-radius: 6px;
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid var(--card-border);
            color: #cbd5e1;
        }

        /* Grid */
        .main-grid {
            display: grid;
            grid-template-columns: 380px 1fr;
            gap: 2rem;
            align-items: start;
        }

        @media (max-width: 900px) {
            .main-grid {
                grid-template-columns: 1fr;
            }
        }

        /* Glassmorphism Card */
        .glass-card {
            background: var(--card-bg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid var(--card-border);
            border-radius: 16px;
            padding: 1.75rem;
            box-shadow: var(--glass-shadow);
        }

        .card-title {
            font-size: 1.25rem;
            font-weight: 700;
            margin-bottom: 1.25rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: #ffffff;
        }

        /* Form Controls */
        .form-group {
            margin-bottom: 1.25rem;
        }

        label {
            display: block;
            font-size: 0.875rem;
            font-weight: 600;
            color: #e2e8f0;
            margin-bottom: 0.5rem;
        }

        input[type="text"],
        input[type="number"] {
            width: 100%;
            padding: 0.8rem 1rem;
            background: rgba(15, 23, 42, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 10px;
            color: #fff;
            font-size: 0.95rem;
            transition: all 0.2s ease;
            outline: none;
        }

        input:focus {
            border-color: var(--accent-primary);
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.25);
            background: rgba(15, 23, 42, 1);
        }

        .input-hint {
            font-size: 0.775rem;
            color: #38bdf8;
            margin-top: 0.35rem;
            display: flex;
            align-items: center;
            gap: 0.25rem;
        }

        .preview-vat-box {
            background: rgba(99, 102, 241, 0.1);
            border: 1px dashed rgba(99, 102, 241, 0.3);
            border-radius: 10px;
            padding: 0.75rem 1rem;
            margin-bottom: 1.25rem;
        }

        .preview-vat-box .label {
            font-size: 0.8rem;
            color: #a5b4fc;
        }

        .preview-vat-box .value {
            font-size: 1.15rem;
            font-weight: 700;
            color: #818cf8;
            margin-top: 0.15rem;
        }

        button.btn-submit {
            width: 100%;
            padding: 0.85rem;
            background: linear-gradient(135deg, #6366f1, #4f46e5);
            border: none;
            border-radius: 10px;
            color: #ffffff;
            font-weight: 700;
            font-size: 0.95rem;
            cursor: pointer;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
            box-shadow: 0 4px 14px rgba(79, 70, 229, 0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        button.btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(79, 70, 229, 0.6);
        }

        button.btn-submit:active {
            transform: translateY(0);
        }

        /* Table Section */
        .table-container {
            overflow-x: auto;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            font-size: 0.925rem;
        }

        th {
            background: rgba(15, 23, 42, 0.85);
            padding: 1rem 1.25rem;
            font-weight: 700;
            color: #cbd5e1;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        td {
            padding: 1rem 1.25rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            color: #e2e8f0;
        }

        tr:last-child td {
            border-bottom: none;
        }

        tr:hover td {
            background: rgba(255, 255, 255, 0.03);
        }

        .code-pill {
            font-family: 'Courier New', Courier, monospace;
            font-weight: 700;
            background: rgba(16, 185, 129, 0.15);
            border: 1px solid rgba(16, 185, 129, 0.3);
            color: #34d399;
            padding: 0.2rem 0.6rem;
            border-radius: 6px;
            font-size: 0.85rem;
        }

        .price-base {
            color: #94a3b8;
        }

        .price-vat {
            font-weight: 700;
            color: #38bdf8;
        }

        .empty-state {
            text-align: center;
            padding: 3rem 1.5rem;
            color: var(--text-muted);
        }

        .empty-state svg {
            width: 48px;
            height: 48px;
            margin-bottom: 1rem;
            opacity: 0.5;
        }

        /* Footer */
        footer {
            background: rgba(15, 23, 42, 0.95);
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(12px);
            padding: 1.5rem 0;
            margin-top: 3rem;
        }

        .footer-inner {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .footer-student {
            display: flex;
            align-items: center;
            gap: 1.5rem;
            flex-wrap: wrap;
        }

        .footer-item {
            display: flex;
            flex-direction: column;
        }

        .footer-label {
            font-size: 0.725rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .footer-value {
            font-size: 0.975rem;
            font-weight: 700;
            color: #ffffff;
        }

        .footer-vat-highlight {
            color: var(--accent-emerald);
        }

        .footer-meta {
            font-size: 0.8rem;
            color: var(--text-muted);
        }
    </style>
</head>
<body>

    <div class="container">
        <header>
            <div class="badge-cloud">
                <span class="pulse"></span> MongoDB Multi-Connection & Stateless Session
            </div>
            <h1>Hệ Thống Quản Lý Sách</h1>
            <p class="subtitle">Kiến trúc Đọc / Ghi riêng biệt kết hợp Stateless Session trên Cloud Atlas</p>
            <div class="arch-tags">
                <span class="tag">📡 Connection Đọc: READ Privilege</span>
                <span class="tag">✍️ Connection Ghi: WRITE Privilege</span>
                <span class="tag">☁️ Session Store: MongoDB Atlas</span>
            </div>
        </header>

        <main class="main-grid">
            <!-- Form Thêm Sách -->
            <section class="glass-card">
                <h2 class="card-title">
                    <span>➕</span> Thêm Sách Mới
                </h2>
                <form action="/add" method="POST" id="addBookForm">
                    <div class="form-group">
                        <label for="maSach">Mã Sách</label>
                        <input 
                            type="text" 
                            id="maSach" 
                            name="maSach" 
                            placeholder="Ví dụ: 077-001" 
                            required 
                            pattern="^077.*$" 
                            title="Mã sách phải bắt đầu bằng 077 (3 số cuối MSSV 23IT.B077)"
                        >
                        <div class="input-hint">
                            ⚡ Bắt buộc bắt đầu bằng tiền tố <strong>077</strong> (3 số cuối MSSV)
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="tenSach">Tên Sách</label>
                        <input 
                            type="text" 
                            id="tenSach" 
                            name="tenSach" 
                            placeholder="Nhập tên sách..." 
                            required
                        >
                    </div>

                    <div class="form-group">
                        <label for="giaGoc">Giá Gốc (VNĐ)</label>
                        <input 
                            type="number" 
                            id="giaGoc" 
                            name="giaGoc" 
                            placeholder="Ví dụ: 100000" 
                            min="0" 
                            step="1000" 
                            required
                        >
                    </div>

                    <div class="preview-vat-box">
                        <div class="label">Giá sau thuế ước tính (VAT {{footerInfo.vat}}):</div>
                        <div class="value" id="previewPrice">0 VNĐ</div>
                    </div>

                    <button type="submit" class="btn-submit">
                        <span>Lưu Vào CSDL (Write Flow)</span> ➜
                    </button>
                </form>
            </section>

            <!-- Bảng Danh Sách Sách -->
            <section class="glass-card">
                <h2 class="card-title">
                    <span>📚</span> Danh Sách Sách (Read Flow)
                </h2>

                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>Mã Sách</th>
                                <th>Tên Sách</th>
                                <th>Giá Gốc</th>
                                <th>Giá Sau Thuế ({{footerInfo.vat}})</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#if books.length}}
                                {{#each books}}
                                    <tr>
                                        <td><span class="code-pill">{{this.maSach}}</span></td>
                                        <td><strong>{{this.tenSach}}</strong></td>
                                        <td class="price-base">{{this.giaGoc}} VNĐ</td>
                                        <td class="price-vat">{{this.giaSauThue}} VNĐ</td>
                                    </tr>
                                {{/each}}
                            {{else}}
                                <tr>
                                    <td colspan="4">
                                        <div class="empty-state">
                                            <p>Chưa có quyển sách nào trong hệ thống.</p>
                                            <p style="font-size: 0.85rem; margin-top: 0.25rem;">Hãy thêm cuốn sách đầu tiên bằng form bên cạnh!</p>
                                        </div>
                                    </td>
                                </tr>
                            {{/if}}
                        </tbody>
                    </table>
                </div>
            </section>
        </main>
    </div>

    <!-- Footer Cá Nhân Hóa (Bắt buộc theo yêu cầu) -->
    <footer>
        <div class="footer-inner">
            <div class="footer-student">
                <div class="footer-item">
                    <span class="footer-label">Sinh Viên Thực Hiện</span>
                    <span class="footer-value">{{footerInfo.hoTen}}</span>
                </div>
                <div class="footer-item">
                    <span class="footer-label">Mã Số Sinh Viên (MSSV)</span>
                    <span class="footer-value">{{footerInfo.mssv}}</span>
                </div>
                <div class="footer-item">
                    <span class="footer-label">Thuế Suất VAT Áp Dụng</span>
                    <span class="footer-value footer-vat-highlight">{{footerInfo.vat}} (Công thức: (7 + 6)%)</span>
                </div>
            </div>
            <div class="footer-meta">
                <span>Điện Toán Đám Mây • Express & MongoDB Atlas</span>
            </div>
        </div>
    </footer>

    <script>
        // Tính nhẩm giá sau thuế tự động trên form
        const giaGocInput = document.getElementById('giaGoc');
        const previewPrice = document.getElementById('previewPrice');
        const vatRate = 0.13; // (Chữ số cuối 7 + 6)% = 13%

        giaGocInput.addEventListener('input', (e) => {
            const val = parseFloat(e.target.value) || 0;
            const afterVat = Math.round(val * (1 + vatRate));
            previewPrice.textContent = afterVat.toLocaleString('vi-VN') + ' VNĐ';
        });
    </script>
</body>
</html>
